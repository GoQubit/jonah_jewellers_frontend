<?xml version="1.0" encoding="utf-8"?>
<!--
  Single splash screen shown by SplashActivity, showing the real app logo
  (the same file used in the web header - public/images/logo2.png, cropped
  to its visible bounds and copied to drawable-nodpi/splash_logo.png). The
  mandatory OS splash (Theme.AppTheme.NoActionBarLaunch) that precedes this
  is made transparent - see styles.xml - so this is the only screen the
  person actually perceives.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:orientation="vertical"
    android:gravity="center">

    <ImageView
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:src="@drawable/splash_logo"
        android:contentDescription="@string/app_name" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <!--
      Used only by SplashActivity, and only for the fraction of a second
      before it can call setKeepOnScreenCondition(() -> false) - see
      SplashActivity.java. Leaving windowSplashScreenAnimatedIcon unset does
      NOT mean "no icon" - Android 12+ has no concept of an icon-less splash
      and silently falls back to the app's LAUNCHER icon (still the old
      circular crown/JJ badge) whenever this isn't set explicitly, which is
      exactly the "old logo" that kept reappearing. @drawable/splash_icon is
      a cropped, padded version of just the diamond+J mark from the current
      header logo (public/images/logo2.png) sized to survive the fixed
      circular mask Android always applies to this icon - the full,
      unclipped wordmark still comes from activity_splash.xml right after.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenIconBackgroundColor">@android:color/white</item>
    </style>
</resources>